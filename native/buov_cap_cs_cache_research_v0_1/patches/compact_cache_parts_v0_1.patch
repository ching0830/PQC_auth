+            let nearest=usize::from(index.abs_diff(private_bases[1])<index.abs_diff(private_bases[0]));
+            if nearest!=cluster {return Err(CompactOperandError);}
+        }
+        if private_bases[0]!=first.unwrap_or(0)
+            || private_bases[1]!=far.unwrap_or(private_bases[0]) {return Err(CompactOperandError);}
