+    pub fn try_from_public_compact_parts(template:Arc<Vec<ShiftedValueIndex>>,private_bases:[u32;2])
+        ->Result<Self,CompactOperandError> {
+        if private_bases.iter().any(|&base|base>=PRIVATE_CAP) {return Err(CompactOperandError);}
+        let mut first=None;let mut far=None;
+        for term in template.iter() {
+            if term.value_index.segment()==ValueSegment::Scratch {return Err(CompactOperandError);}
+            for shift in term.shift_seq {
+                if !shift.is_canonical() || usize::from(shift.amount)>=shift.variant.max_amount() {
+                    return Err(CompactOperandError);
+                }
+            }
+            if term.is_unshifted() && term.is_doubly_shifted() {return Err(CompactOperandError);}
+            if term.is_doubly_shifted()
+                && super::Shift::compose(term.inner(),term.outer())!=super::Composition::Pair {
+                return Err(CompactOperandError);
+            }
+            if term.value_index.segment()!=ValueSegment::Private {continue;}
+            let encoded=term.value_index.index();let cluster=(encoded>>DELTA_BITS) as usize;
+            let delta=encoded&DELTA_MASK;
+            let index=delta.wrapping_add(private_bases[cluster])&DELTA_MASK;
