 use std::{num::NonZero, sync::OnceLock, thread::available_parallelism};
 
 use super::ThreadPoolBuildError;
+
+/// Requested worker-stack component of the bounded research profile.
+/// Guard pages, allocator/runtime metadata and the calling thread are separate.
+pub const RESEARCH_WORKER_STACK_BYTES: usize = 2 * 1024 * 1024;
+
+/// Only the explicitly authorized research widths. This changes no polynomial,
+/// sampler, oracle schedule or security parameter. Unsupported widths reject
+/// before a pool or NTT task configuration is constructed.
+pub fn research_log_num_shares(width: usize) -> usize {
+    assert!(matches!(width, 1 | 2 | 4), "research parallel width must be 1, 2 or 4");
+    width.ilog2() as usize
+}
+
+/// Builds exactly one bounded global research pool. Call once, before ANY
+/// parallel operation; an already initialized global pool returns an error.
+/// Width 1 uses the calling thread. Width 2/4 creates that many workers in
+/// addition to the caller, so the OS thread count is normally 3/5 respectively.
+/// Process CPU affinity and tree/RSS/wall/AS limits remain runner obligations.
+pub fn adjust_research_thread_pool(width: usize) -> Result<(), ThreadPoolBuildError> {
+    let _ = research_log_num_shares(width);
+    let builder = super::ThreadPoolBuilder::new().num_threads(width)
+        .stack_size(RESEARCH_WORKER_STACK_BYTES);
+    if width == 1 { builder.use_current_thread().build_global() }
+    else { builder.build_global() }
+}
 
 /// Builds the global rayon pool, sized to the machine's physical cores.
