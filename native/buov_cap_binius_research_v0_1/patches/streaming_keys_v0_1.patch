+            cs.zero_constraints.push(binius_core::constraint_system::ZeroConstraint([vec![dup, dup]]));
+            cs.and_constraints[0].0[1].push(ShiftedValueIndex::sll(ValueIndex::inout(2), 3));
+            let cs = Arc::new(cs);
