+            let new = KeyCollection::from_shared(Arc::clone(&cs), inout);
+            assert!(new.is_streaming());
+            assert_eq!(new.public.keys.len() + new.hidden.keys.len(), 0);
+            assert_eq!(new.public.constraint_indices.len() + new.hidden.constraint_indices.len(), 0);
+            assert_eq!(new.public.key_ranges.len() + new.hidden.key_ranges.len(), 0);
+            assert!(Arc::ptr_eq(&cs, &new.source.as_ref().unwrap().0));
+            assert_eq!(new.n_public_words(), old.n_public_words());
+            assert_eq!(new.n_hidden_words(), old.n_hidden_words());
+            let prepared = PreparedOperandClaims {
