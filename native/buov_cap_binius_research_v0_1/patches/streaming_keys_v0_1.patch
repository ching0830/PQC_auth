+
+/// Traverses source operands with exactly the ZERO/AND/IMUL/BMUL column layout.
+fn operands(cs: &ConstraintSystem) -> impl Iterator<Item = (usize, usize, &Operand)> {
+    fn walk<C: AsRef<[Operand; N]>, const N: usize>(first: usize, cs: &[C])
+        -> impl Iterator<Item = (usize, usize, &Operand)> {
+        cs.iter().enumerate().flat_map(move |(row, c)| {
+            c.as_ref().iter().enumerate().map(move |(col, op)| (first + col, row, op))
+        })
+    }
+    walk(0, &cs.zero_constraints).chain(walk(1, &cs.and_constraints))
+        .chain(walk(4, &cs.imul_constraints)).chain(walk(8, &cs.bmul_constraints))
+}
+
+/// Only the bounded set of distinct shift sequences is materialized, never term references.
+pub(super) fn encodings(cs: &ConstraintSystem, inout: InoutSegment) -> (KeySegment, KeySegment) {
+    let public_words = cs.n_public_words(inout);
+    let sequences = |hidden: bool| {
+        operands(cs).flat_map(move |(_, _, terms)| terms.iter().filter_map(move |term| {
+            let word = cs.word_offset(term.value_index);
+            ((word >= public_words) == hidden).then_some([term.inner(), term.outer()])
+        }))
+    };
+    let segment = |hidden| KeySegment {
+        keys: Vec::new(), key_ranges: Vec::new(), constraint_indices: Vec::new(),
+        dense_shift_enc: DenseShiftEncoding::new(sequences(hidden)),
+    };
+    (segment(false), segment(true))
+}
+
+/// Evaluates the same witness-and-batching rows as indexed keys, directly from source terms.
+/// Distribution over every occurrence preserves repeated-term cancellation without storing keys.
+pub(super) fn build_g<F: Field, P: PackedField<Scalar = F>>(
+    cs: &ConstraintSystem,
+    inout: InoutSegment,
+    encodings: [&DenseShiftEncoding; 2],
+    words: SegmentWords<'_>,
+    prepared: &PreparedOperandClaims<F>,
+) -> (Box<[P]>, Box<[P]>) {
+    let n_public = cs.n_public_words(inout);
+    assert_eq!(words.public.len(), n_public);
+    assert_eq!(words.hidden.len(), cs.n_hidden_words(inout));
+    let row_len = row_len::<P>();
+    let mut rows = encodings.map(|enc| vec![P::default(); enc.len() * row_len].into_boxed_slice());
+    for (column, constraint, terms) in operands(cs) {
+        let weight = prepared.r_x_tensor[constraint] * prepared.operand_weights[column];
+        for term in terms {
+            let absolute = cs.word_offset(term.value_index);
+            let (segment, word) = if absolute < n_public {
+                (0, words.public[absolute])
+            } else { (1, words.hidden[absolute - n_public]) };
+            let shift = encodings[segment].dense_idx([term.inner(), term.outer()]) as usize;
+            let start = shift * row_len;
+            let mut set_bits = word.0;
+            while set_bits != 0 {
+                let bit = set_bits.trailing_zeros() as usize;
+                let slot = &mut rows[segment][start + bit / P::WIDTH];
+                let lane = bit % P::WIDTH;
+                slot.set(lane, slot.get(lane) + weight);
+                set_bits &= set_bits - 1;
+            }
+        }
+    }
+    let [public, hidden] = rows;
+    (public, hidden)
+}
+
+/// Builds the exact two monster polynomials without PackedRef/ConstraintIndex/key arrays.
+pub(super) fn build_monster<F, P: PackedField<Scalar = F>, A: Allocator>(
+    cs: &ConstraintSystem,
+    inout: InoutSegment,
+    encodings: [&DenseShiftEncoding; 2],
+    alloc: &A,
+    prepared: &PreparedOperandClaims<F>,
+    h_eval: F,
+    inner: &ShiftChallenge<F>,
+    outer: &ShiftChallenge<F>,
+) -> (FieldVec<P, A>, FieldVec<P, A>)
+where F: BinaryField {
+    let mut public = FieldBuffer::zeros_in(alloc, cs.log_public_words(inout));
+    let mut hidden = FieldBuffer::zeros_in(alloc, cs.log_witness_words(inout));
+    let n_public = cs.n_public_words(inout);
+    let r_v = eq_ind_partial_eval::<F>(&inner.variant);
+    let r_s = eq_ind_partial_eval::<F>(&inner.amount);
+    let outer_weights = OuterSlotWeights::<F>::new(outer);
+    let scalars = encodings.map(|encoding| encoding.iter().map(|[inner, outer]| {
+        h_eval * r_v.as_ref()[inner.variant as usize]
+            * r_s.as_ref()[inner.amount as usize] * outer_weights.weight(outer)
+    }).collect::<Vec<_>>());
+    for (column, constraint, terms) in operands(cs) {
+        let weight = prepared.r_x_tensor[constraint] * prepared.operand_weights[column];
+        for term in terms {
+            let absolute = cs.word_offset(term.value_index);
+            let (segment, index) = if absolute < n_public { (0, absolute) }
+                else { (1, absolute - n_public) };
+            let shift = encodings[segment].dense_idx([term.inner(), term.outer()]) as usize;
+            let contribution = weight * scalars[segment][shift];
+            if segment == 0 { public.set(index, public.get(index) + contribution); }
+            else { hidden.set(index, hidden.get(index) + contribution); }
+        }
+    }
+    (public, hidden)
+}
