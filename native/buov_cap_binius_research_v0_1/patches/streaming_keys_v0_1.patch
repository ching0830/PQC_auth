+            let old_g = old.build_g::<_, P>(SegmentWords { public: &public_words, hidden: &hidden_words }, &prepared);
+            let new_g = new.build_g::<_, P>(SegmentWords { public: &public_words, hidden: &hidden_words }, &prepared);
+            assert_eq!(old_g, new_g);
