+//! Public wire-structure compression; never specializes on witness values.
+use std::{collections::HashSet, fmt, sync::Arc};
+use binius_utils::serialization::{DeserializeBytes,SerializationError,SerializeBytes};
+use bytes::{Buf,BufMut};
+use super::{Operand,ShiftedValueIndex,ValueIndex,ValueSegment};
+
+/// Sixteen bytes on the admitted x64 platform. Only private indices are
+/// relative to two public wire-address bases; Constant/InOut identities and
+/// both shift slots remain unchanged. Admitted private indices are <2^26.
+/// Template bit29 tags the second base; lower29 bits store delta mod2^29.
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub struct StoredOperand {template:Arc<Vec<ShiftedValueIndex>>,private_bases:[u32;2]}
+
+#[derive(Clone)]
+pub struct StoredTerms<'a> {terms:std::slice::Iter<'a,ShiftedValueIndex>,private_bases:[u32;2]}
+impl Iterator for StoredTerms<'_> {
+    type Item=ShiftedValueIndex;
+    fn next(&mut self)->Option<Self::Item> {self.terms.next().map(|term| {
+        let mut term=*term;
+        if term.value_index.segment()==ValueSegment::Private {
+            let encoded=term.value_index.index();
+            let cluster=(encoded>>DELTA_BITS) as usize;
+            let index=(encoded&DELTA_MASK).wrapping_add(self.private_bases[cluster])&DELTA_MASK;
+            assert!(index<PRIVATE_CAP,"decoded private index exceeds admitted research shape");
+            term.value_index=ValueIndex::private(index);
+        }
+        term
+    })}
+    fn size_hint(&self)->(usize,Option<usize>) {self.terms.size_hint()}
+}
+impl ExactSizeIterator for StoredTerms<'_> {}
+impl<'a> IntoIterator for &'a StoredOperand {
+    type Item=ShiftedValueIndex;type IntoIter=StoredTerms<'a>;
+    fn into_iter(self)->Self::IntoIter {self.iter()}
+}
+const PRIVATE_CAP:u32=1<<26;
+const DELTA_BITS:u32=29;
+const DELTA_MASK:u32=(1<<DELTA_BITS)-1;
+const SECOND_CLUSTER_DISTANCE:u32=4096;
+fn normalize(mut terms:Operand)->Result<([u32;2],Operand),TemplateLimitError> {
+    if terms.iter().any(|t|t.value_index.segment()==ValueSegment::Private && t.value_index.index()>=PRIVATE_CAP) {
+        return Err(TemplateLimitError::PrivateIndexOutOfRange);
+    }
+    let base1=terms.iter().find(|t|t.value_index.segment()==ValueSegment::Private)
+        .map_or(0,|t|t.value_index.index());
+    let base2=terms.iter().find(|t|t.value_index.segment()==ValueSegment::Private
+        && t.value_index.index().abs_diff(base1)>SECOND_CLUSTER_DISTANCE)
+        .map_or(base1,|t|t.value_index.index());
+    let bases=[base1,base2];
+    for term in &mut terms {
+        if term.value_index.segment()==ValueSegment::Private {
+            let index=term.value_index.index();
+            // Nearest public ADDRESS base; ties always use the first cluster.
+            // This never reads a word from the secret witness.
+            let cluster=usize::from(index.abs_diff(base2)<index.abs_diff(base1));
+            let delta=index.wrapping_sub(bases[cluster])&DELTA_MASK;
+            term.value_index=ValueIndex::private(delta|((cluster as u32)<<DELTA_BITS));
+        }
+    }
+    terms.shrink_to_fit();Ok((bases,terms))
+}
+impl From<Operand> for StoredOperand {
+    fn from(terms:Operand)->Self {let (private_bases,terms)=normalize(terms).expect("private operand index exceeds admitted 26-bit research shape");Self{private_bases,template:Arc::new(terms)}}
+}
+impl Default for StoredOperand {fn default()->Self {Vec::new().into()}}
+impl FromIterator<ShiftedValueIndex> for StoredOperand {
+    fn from_iter<T:IntoIterator<Item=ShiftedValueIndex>>(terms:T)->Self {terms.into_iter().collect::<Operand>().into()}
+}
+impl StoredOperand {
+    pub fn len(&self)->usize {self.template.len()}
+    pub fn is_empty(&self)->bool {self.template.is_empty()}
+    pub fn iter(&self)->StoredTerms<'_> {StoredTerms{terms:self.template.iter(),private_bases:self.private_bases}}
+    /// Compatibility mutation for small tests/builders; breaks sharing safely.
+    pub fn push(&mut self,term:ShiftedValueIndex) {let mut terms:Operand=self.iter().collect();terms.push(term);*self=terms.into();}
+    /// Compatibility filter over decoded PUBLIC wire structure. Rebuilds this
+    /// operand's normalized template without mutating any shared Arc allocation.
+    pub fn retain(&mut self,keep:impl FnMut(&ShiftedValueIndex)->bool) {
+        let mut terms:Operand=self.iter().collect();terms.retain(keep);*self=terms.into();
+    }
+    pub fn shares_template_with(&self,other:&Self)->bool {Arc::ptr_eq(&self.template,&other.template)}
+}
+impl PartialEq<Operand> for StoredOperand {
+    fn eq(&self,other:&Operand)->bool {self.iter().eq(other.iter().copied())}
+}
+impl SerializeBytes for StoredOperand {
+    fn serialize(&self,mut out:impl BufMut)->Result<(),SerializationError> {
+        self.len().serialize(&mut out)?;
+        for term in self {term.serialize(&mut out)?;}Ok(())
+    }
+}
+impl DeserializeBytes for StoredOperand {
+    fn deserialize(input:impl Buf)->Result<Self,SerializationError> {
+        let (private_bases,terms)=normalize(Operand::deserialize(input)?)
+            .map_err(|_|SerializationError::InvalidConstruction{name:"StoredOperand::private_index_range"})?;
+        Ok(Self{private_bases,template:Arc::new(terms)})
+    }
+}
+
+#[derive(Clone,Debug,Default)]
+pub struct TemplateMetrics {
+    pub unique_templates:usize,pub template_terms:usize,pub payload_bytes:usize,
+    pub operand_count:usize,pub referenced_terms:usize,pub hash_capacity:usize,
+}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum TemplateLimitError {DictionaryLimit,PrivateIndexOutOfRange}
+impl fmt::Display for TemplateLimitError {fn fmt(&self,f:&mut fmt::Formatter<'_>)->fmt::Result {f.write_str(match self {Self::DictionaryLimit=>"public operand-template census limit exceeded",Self::PrivateIndexOutOfRange=>"private wire index exceeds admitted 26-bit research shape"})}}
+impl std::error::Error for TemplateLimitError {}
+
+/// Explicit per-relation dictionary. No global cache or secret-data key exists.
+/// Census and actual construction call the SAME intern method; census drops
+/// the returned handle immediately instead of retaining any CS operand rows.
+pub struct TemplateInterner {
+    templates:HashSet<Arc<Vec<ShiftedValueIndex>>>,max_unique:usize,max_payload_bytes:usize,
+    metrics:TemplateMetrics,
+}
+impl TemplateInterner {
+    pub fn new(max_unique:usize,max_payload_bytes:usize)->Self {
+        assert!(max_unique>0 && max_unique<=1_000_000 && max_payload_bytes<=256*1024*1024,
+            "bounded public template dictionary policy");
+        Self{templates:HashSet::new(),max_unique,max_payload_bytes,metrics:TemplateMetrics::default()}
+    }
+    pub fn intern(&mut self,terms:Operand)->Result<StoredOperand,TemplateLimitError> {
+        let n=terms.len();let (private_bases,terms)=normalize(terms)?;
+        let template=if let Some(found)=self.templates.get(&terms) {Arc::clone(found)} else {
+            // 40B is Arc counters + Vec header on x64; the public metrics are
+            // requested components, excluding HashSet buckets/allocator spare.
+            let bytes=40usize.checked_add(8usize.checked_mul(n).ok_or(TemplateLimitError::DictionaryLimit)?).ok_or(TemplateLimitError::DictionaryLimit)?;
+            let total=self.metrics.payload_bytes.checked_add(bytes).ok_or(TemplateLimitError::DictionaryLimit)?;
+            if self.templates.len()>=self.max_unique || total>self.max_payload_bytes {return Err(TemplateLimitError::DictionaryLimit);}
+            let template=Arc::new(terms);self.templates.insert(Arc::clone(&template));
+            self.metrics.payload_bytes=total;self.metrics.template_terms+=n;template
+        };
+        self.metrics.operand_count+=1;self.metrics.referenced_terms+=n;
+        Ok(StoredOperand{template,private_bases})
+    }
+    pub fn metrics(&self)->TemplateMetrics {
+        let mut m=self.metrics.clone();m.unique_templates=self.templates.len();m.hash_capacity=self.templates.capacity();m
+    }
+}
+
