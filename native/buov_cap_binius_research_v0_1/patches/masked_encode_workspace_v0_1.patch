+    /// Encodes an owned message in its already reserved final codeword allocation.
+    ///
+    /// The live prefix is the same interleaved message accepted by [`Self::encode_batch`]. Its
+    /// backing store must have room for the whole codeword. This method does not copy that prefix
+    /// into another full-size allocation: permutation, skipped-layer repetition, and the NTT all
+    /// operate on this backing store. The original allocating encoder remains a differential
+    /// reference and supports borrowed inputs as before.
+    ///
+    /// # Panics
+    ///
+    /// Panics before transforming if the message shape, NTT subspace, codeword address width, or
+    /// reserved capacity is invalid. All sums are checked before shifts or allocations.
+    pub fn encode_batch_inplace<P, NTT, Data>(
+        &self,
+        ntt: &NTT,
+        data: FieldBuffer<P, Data>,
+        log_batch_size: usize,
+    ) -> FieldBuffer<P, Data>
+    where
+        P: PackedField<Scalar = F>,
+        NTT: AdditiveNTT<Field = F> + Sync,
+        Data: VecLike<P>,
+    {
+        let log_input_len = self.log_dim().checked_add(log_batch_size)
+            .expect("precondition: interleaved message log length must not overflow");
+        let log_output_len = log_input_len.checked_add(self.log_inv_rate)
+            .expect("precondition: codeword log length must not overflow");
+        assert!(log_output_len < usize::BITS as usize,
+            "precondition: codeword scalar length must fit usize");
+        assert_eq!(data.log_len(), log_input_len,
+            "precondition: data.log_len() must equal log_dim() + log_batch_size");
+        let values = data.into_inner();
+        let packed_output_len = 1usize << log_output_len.saturating_sub(P::LOG_WIDTH);
+        assert!(values.capacity() >= packed_output_len,
+            "precondition: owned buffer must reserve the whole codeword");
+        assert_eq!(ntt.subspace(self.log_len()), self.subspace(),
+            "precondition: NTT subspace must match code subspace");
+
+        let _scope = tracing::trace_span!("Reed-Solomon encode in owned workspace",
+            log_len = self.log_len(), log_batch_size, symbol_bits = F::N_BITS).entered();
+        let mut output = FieldBuffer::new(log_input_len, values);
+        bit_reverse_packed(output.as_mut_view());
+        output.repeat_extend(log_output_len);
+        ntt.forward_transform(output.as_mut_view(), self.log_inv_rate, log_batch_size);
+        output
+    }
+
 }
 
