+/// Evaluates a streamed multiset of addresses without storing or sorting expanded wiring.
+///
+/// Addresses use at most 127 coordinates. Repeated addresses cancel in pairs because the
+/// coefficient field has characteristic two. No address bits are dropped or converted to usize
+/// before their bounded (at most 16-coordinate) chunk is selected.
+pub fn evaluate_sparse_b1_multilinear_streaming<E: FieldOps>(
+    point: &[E],
+    n_terms: usize,
+    indices: impl IntoIterator<Item = u128>,
+) -> E {
+    let chunks = expand_streaming_chunks(point, n_terms);
+    indices.into_iter().map(|index| {
+        assert!(index >> point.len() == 0, "streamed address is out of range");
+        chunks.iter().map(|(range, tensor)| lookup_wide(index, range, tensor))
+            .reduce(|acc, value| acc * value).expect("there is at least one chunk")
+    }).sum()
+}
+
+/// Native-field version of [`evaluate_sparse_b1_multilinear_streaming`], with one reduction.
+pub fn evaluate_sparse_b1_multilinear_streaming_native<F: Field>(
+    point: &[F],
+    n_terms: usize,
+    indices: impl IntoIterator<Item = u128>,
+) -> F {
+    let chunks = expand_streaming_chunks(point, n_terms);
+    let (last, init) = chunks.split_last().expect("there is at least one chunk");
+    let wide = indices.into_iter().map(|index| {
+        assert!(index >> point.len() == 0, "streamed address is out of range");
+        let prefix = init.iter().map(|(range, tensor)| lookup_wide(index, range, tensor)).product();
+        F::wide_mul(prefix, lookup_wide(index, &last.0, &last.1))
+    }).sum();
+    F::reduce(wide)
+}
+
+fn expand_streaming_chunks<E: FieldOps>(point: &[E], n_terms: usize) -> Vec<(Range<usize>, Vec<E>)> {
+    assert!(point.len() < u128::BITS as usize, "streaming log_len must be less than 128");
+    chunk_ranges(n_terms, point.len()).into_iter().map(|range| {
+        let tensor = eq_ind_partial_eval_scalars(&point[range.clone()]);
+        (range, tensor)
+    }).collect()
+}
+
+fn lookup_wide<E: FieldOps>(index: u128, range: &Range<usize>, tensor: &[E]) -> E {
+    tensor[((index >> range.start) & ((1u128 << range.len()) - 1)) as usize].clone()
 }
 
