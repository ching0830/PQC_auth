+impl<F: Field, H: ParallelHashSuite, A: Allocator> BinaryMerkleTreeProver<F, H, A> {
+    /// Commits directly to sixteen-leaf subtree roots and the layers above them. Small trees
+    /// retain the existing full representation. No codeword, callback, or pointer is retained.
+    pub fn commit_field_buffer_checkpointed<P: PackedField<Scalar = F>>(
+        &self, data: FieldSlice<'_, P>, log_leaf_size: usize,
+    ) -> (Commitment<Output<H::LeafHash>>, DataMerkleTree<Output<H::LeafHash>, A>) {
+        let depth = data.log_len().checked_sub(log_leaf_size)
+            .expect("precondition: leaf fits the codeword");
+        assert!(depth < usize::BITS as usize, "precondition: Merkle addresses fit usize");
+        if depth < CHECKPOINT_LOG_DEPTH {
+            let (commitment, tree) = self.commit_field_buffer(data, log_leaf_size);
+            return (commitment, DataMerkleTree::Full(tree));
+        }
+        let top_depth = depth - CHECKPOINT_LOG_DEPTH;
+        let roots = (0..1usize << top_depth).into_par_iter().map(|index| {
+            small_subtree::<F, P, H>(data.chunk(log_leaf_size + CHECKPOINT_LOG_DEPTH, index), log_leaf_size).root()
+        });
+        let top = BinaryMerkleTree::from_prehashed_leaves(roots, &H::Compression::default(), &self.alloc);
+        let commitment = Commitment { root: top.root(), depth };
+        (commitment, DataMerkleTree::Checkpointed { top, log_leaf_size })
+    }
+
+    fn check_codeword<P: PackedField<Scalar = F>>(
+        &self, tree: &DataMerkleTree<Output<H::LeafHash>, A>, data: FieldSlice<'_, P>, log_leaf_size: usize,
+    ) {
+        assert_eq!(data.log_len().checked_sub(log_leaf_size), Some(tree.log_len()),
+            "precondition: opening codeword shape must match the commitment");
+        if let DataMerkleTree::Checkpointed { log_leaf_size: committed, .. } = tree {
+            assert_eq!(*committed, log_leaf_size, "precondition: opening leaf shape must match the commitment");
+        }
+    }
+
+    fn checked_subtree<P: PackedField<Scalar = F>>(
+        &self, top: &BinaryMerkleTree<Output<H::LeafHash>, A>, data: FieldSlice<'_, P>,
+        log_leaf_size: usize, checkpoint_index: usize,
+    ) -> Result<SmallSubtree<Output<H::LeafHash>>, Error> {
+        let small = small_subtree::<F, P, H>(data.chunk(log_leaf_size + CHECKPOINT_LOG_DEPTH, checkpoint_index), log_leaf_size);
+        if small.root() != top.layer(top.log_len)?[checkpoint_index] {
+            return Err(Error::CheckpointDataMismatch { checkpoint_index });
+        }
+        Ok(small)
+    }
+
+    /// Serves every valid layer. Retained top layers are borrowed; omitted layers are rebuilt
+    /// into a temporary owned layer, with every contributing subtree checked against its root.
+    pub fn layer_from_data<'a, P: PackedField<Scalar = F>>(
+        &self, tree: &'a DataMerkleTree<Output<H::LeafHash>, A>, data: FieldSlice<'_, P>,
+        log_leaf_size: usize, layer_depth: usize,
+    ) -> Result<Cow<'a, [Output<H::LeafHash>]>, Error> {
+        self.check_codeword(tree, data, log_leaf_size);
+        if layer_depth > tree.log_len() {
+            return Err(Error::IncorrectLayerDepth { layer_depth, log_len: tree.log_len() });
+        }
+        match tree {
+            DataMerkleTree::Full(full) => Ok(Cow::Borrowed(full.layer(layer_depth)?)),
+            DataMerkleTree::Checkpointed { top, .. } if layer_depth <= top.log_len =>
+                Ok(Cow::Borrowed(top.layer(layer_depth)?)),
+            DataMerkleTree::Checkpointed { top, .. } => {
+                let local_depth = layer_depth - top.log_len;
+                let mut layer = Vec::with_capacity(1usize << layer_depth);
+                for checkpoint_index in 0..1usize << top.log_len {
+                    let small = self.checked_subtree(top, data, log_leaf_size, checkpoint_index)?;
+                    layer.extend_from_slice(small.layer(local_depth));
+                }
+                Ok(Cow::Owned(layer))
+            }
+        }
+    }
+
+    /// Recomputes at most sixteen leaves and their local branch, checks their checkpoint, then
+    /// appends the retained upper path. Digest order is exactly the ordinary leaf-to-cap order.
+    pub fn branch_from_data<P: PackedField<Scalar = F>>(
+        &self, tree: &DataMerkleTree<Output<H::LeafHash>, A>, data: FieldSlice<'_, P>,
+        log_leaf_size: usize, layer_depth: usize, index: usize,
+    ) -> Result<Vec<Output<H::LeafHash>>, Error> {
+        self.check_codeword(tree, data, log_leaf_size);
+        if index >= 1usize << tree.log_len() {
+            return Err(Error::IndexOutOfRange { index, log_len: tree.log_len() });
+        }
+        if layer_depth > tree.log_len() {
+            return Err(Error::IncorrectLayerDepth { layer_depth, log_len: tree.log_len() });
+        }
+        match tree {
+            DataMerkleTree::Full(full) => full.branch(index, layer_depth),
+            DataMerkleTree::Checkpointed { top, .. } => {
+                let checkpoint_index = index >> CHECKPOINT_LOG_DEPTH;
+                let small = self.checked_subtree(top, data, log_leaf_size, checkpoint_index)?;
+                let local_cap = layer_depth.saturating_sub(top.log_len);
+                let mut branch = small.branch(index & ((1usize << CHECKPOINT_LOG_DEPTH) - 1), local_cap);
+                if layer_depth < top.log_len {
+                    branch.extend(top.branch(checkpoint_index, layer_depth)?);
+                }
+                Ok(branch)
+            }
+        }
+    }
+}
