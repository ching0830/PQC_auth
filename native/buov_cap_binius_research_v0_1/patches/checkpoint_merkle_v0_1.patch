+/// Bottom subtree height rebuilt from the caller's live borrowed codeword at opening time.
+pub const CHECKPOINT_LOG_DEPTH: usize = 4;
+
+/// Data-aware channel storage. The ordinary MerkleTreeProver trait keeps its full-tree type.
+pub enum DataMerkleTree<D: Send, A: Allocator = GlobalAllocator> {
+    Full(BinaryMerkleTree<D, A>),
+    Checkpointed { top: BinaryMerkleTree<D, A>, log_leaf_size: usize },
+}
+
+impl<D: Send, A: Allocator> From<BinaryMerkleTree<D, A>> for DataMerkleTree<D, A> {
+    fn from(tree: BinaryMerkleTree<D, A>) -> Self { Self::Full(tree) }
+}
+
+impl<D: Clone + Send, A: Allocator> DataMerkleTree<D, A> {
+    fn top(&self) -> &BinaryMerkleTree<D, A> {
+        match self { Self::Full(tree) => tree, Self::Checkpointed { top, .. } => top }
+    }
+    pub fn root(&self) -> D { self.top().root() }
+    pub fn log_len(&self) -> usize {
+        self.top().log_len + if self.is_checkpointed() { CHECKPOINT_LOG_DEPTH } else { 0 }
+    }
+    pub fn is_checkpointed(&self) -> bool { matches!(self, Self::Checkpointed { .. }) }
+    pub fn stored_nodes(&self) -> usize { self.top().inner_nodes.len() }
+    pub fn stored_capacity(&self) -> usize { self.top().inner_nodes.capacity() }
+}
+
+/// Fixed-size local workspace; it never stores or borrows a codeword after the call returns.
+struct SmallSubtree<D> { log_len: usize, nodes: [D; 31] }
+
+impl<D: Clone> SmallSubtree<D> {
+    fn layer(&self, depth: usize) -> &[D] {
+        assert!(depth <= self.log_len);
+        let start = (1usize << (self.log_len + 1)) - (1usize << (depth + 1));
+        &self.nodes[start..start + (1usize << depth)]
+    }
+    fn root(&self) -> D { self.layer(0)[0].clone() }
+    fn branch(&self, index: usize, layer_depth: usize) -> Vec<D> {
+        (0..self.log_len - layer_depth).map(|height| {
+            self.layer(self.log_len - height)[(index >> height) ^ 1].clone()
+        }).collect()
+    }
+}
+
+fn small_subtree<F, P, H>(data: FieldSlice<'_, P>, log_leaf_size: usize) -> SmallSubtree<Output<H::LeafHash>>
+where F: Field, P: PackedField<Scalar = F>, H: ParallelHashSuite {
+    let log_len = data.log_len().checked_sub(log_leaf_size)
+        .expect("precondition: leaf fits the codeword");
+    assert!(log_len <= CHECKPOINT_LOG_DEPTH);
+    let n_leaves = 1usize << log_len;
+    let mut leaves: [MaybeUninit<Output<H::LeafHash>>; 16] = std::array::from_fn(|_| MaybeUninit::uninit());
+    H::ParLeafHash::default().digest_with_const_len(1usize << log_leaf_size,
+        data.par_chunk_scalars(log_leaf_size), &mut leaves[..n_leaves]);
+    let mut nodes = std::array::from_fn(|_| Output::<H::LeafHash>::default());
+    for i in 0..n_leaves {
+        // SAFETY: digest_with_const_len initialized exactly the n_leaves output slots above.
+        nodes[i] = unsafe { leaves[i].assume_init_read() };
+    }
+    let compression = H::Compression::default();
+    let (mut start, mut width, mut written) = (0, n_leaves, n_leaves);
+    while width > 1 {
+        for i in 0..width / 2 {
+            nodes[written + i] = compression.compress([nodes[start + 2 * i].clone(), nodes[start + 2 * i + 1].clone()]);
+        }
+        start += width;
+        width /= 2;
+        written += width;
+    }
+    SmallSubtree { log_len, nodes }
+}
 
