+/// Builds only the retained tree above already-hashed subtree roots.
+///
+/// One final allocation holds the prehashed base layer and every layer above it. The roots are
+/// written directly into that allocation; no leaf-hash or second checkpoint array is retained.
+impl<D: Clone + Send + Sync, A: Allocator> BinaryMerkleTree<D, A> {
+    pub fn from_prehashed_leaves<C, I>(leaves: I, compression: &C, alloc: &A) -> Self
+    where
+        C: CompressionFunction<D, 2>,
+        I: IndexedParallelIterator<Item = D>,
+    {
+        let n_leaves = leaves.len();
+        let log_len = checked_log_2(n_leaves);
+        let total = n_leaves.checked_mul(2).and_then(|n| n.checked_sub(1))
+            .expect("precondition: retained Merkle tree length fits usize");
+        let mut nodes = alloc.alloc::<D>(total);
+        leaves.zip(&mut nodes.spare_capacity_mut()[..n_leaves]).for_each(|(digest, slot)| {
+            slot.write(digest);
+        });
+        // SAFETY: the indexed zip above writes every one of these n_leaves slots exactly once.
+        unsafe { nodes.set_len(n_leaves); }
+        let (mut start, mut width) = (0, n_leaves);
+        while width > 1 {
+            for i in 0..width / 2 {
+                let digest = compression.compress([nodes[start + 2 * i].clone(), nodes[start + 2 * i + 1].clone()]);
+                nodes.push(digest);
+            }
+            start += width;
+            width /= 2;
+        }
+        assert_eq!(nodes.len(), total);
+        Self { log_len, inner_nodes: nodes }
+    }
+}
