+#[cfg(test)]
+mod research_schedule_tests {
+    use super::*;
+    use binius_core::constraint_system::{AndConstraint,ValueIndex,ZeroConstraint};
+    use binius_hash::StdHashSuite;
+    fn small_cs()->ConstraintSystem {
+        ConstraintSystem{constants:vec![Word(u64::MAX)],n_inout:1,n_private:4,
+            and_constraints:vec![AndConstraint::plain_abc([ValueIndex::private(0)],
+                [ValueIndex::private(1)],[ValueIndex::private(2)])],
+            zero_constraints:vec![ZeroConstraint::plain([ValueIndex::private(2),ValueIndex::inout(0)]),
+                ZeroConstraint::plain([ValueIndex::private(3)])],
+            imul_constraints:Vec::new(),bmul_constraints:Vec::new()}
+    }
+    #[test]
+    fn research_setup_preserves_actual_oracles_and_rebuilds_fri_blinding() {
+        let ordinary=ZKVerifier::<StdHashSuite>::setup(small_cs(),1).unwrap();
+        let research=ZKVerifier::<StdHashSuite>::setup_research_unmerged(small_cs(),1).unwrap();
+        assert!(!ordinary.is_research_unmerged());assert!(research.is_research_unmerged());
+        assert_eq!(ordinary.oracle_schedule().specs(),research.oracle_schedule().specs());
+        assert_eq!(research.oracle_schedule().n_rounds(),research.oracle_schedule().specs().len());
+        assert_eq!(research.basefold_compiler().oracle_specs(),research.oracle_schedule().specs());
+        let queries=fri::calculate_n_test_queries(SECURITY_BITS,1);
+        assert_eq!(research.basefold_compiler().fri_params().n_test_queries(),queries);
+        assert_eq!(research.outer_iop_verifier().constraint_system().blinding_info().n_dummy_wires,queries+1);
+        let mut bytes=Vec::new();assert!(research.serialize(&mut bytes).is_err());assert!(bytes.is_empty());
+    }
+    #[test]
+    fn default_codec_still_contains_exactly_its_v1_seed_and_reloads_as_default() {
+        let ordinary=ZKVerifier::<StdHashSuite>::setup(small_cs(),1).unwrap();
+        let mut expected=Vec::new();1u32.serialize(&mut expected).unwrap();
+        ordinary.constraint_system().serialize(&mut expected).unwrap();1usize.serialize(&mut expected).unwrap();
+        let mut actual=Vec::new();ordinary.serialize(&mut actual).unwrap();assert_eq!(actual,expected);
+        let reloaded=ZKVerifier::<StdHashSuite>::deserialize(actual.as_slice()).unwrap();
+        assert!(!reloaded.is_research_unmerged());assert_eq!(ordinary.oracle_schedule(),reloaded.oracle_schedule());
+    }
