+#[cfg(test)]
+mod research_schedule_tests {
+    use super::*;
+    use super::oracle_setup::OracleSetupChannel;
+    use binius_field::Ghash128b;
+    #[test]
+    fn actual_specs_are_unchanged_when_each_oracle_gets_its_own_group() {
+        let mut channel=OracleSetupChannel::new(true);
+        IOPVerifierChannel::<Ghash128b>::recv_oracle(&mut channel,3,2,true).unwrap();
+        IOPVerifierChannel::<Ghash128b>::recv_oracle(&mut channel,5,3,false).unwrap();
+        let ordinary=channel.into_oracle_schedule();
+        let research=ordinary.clone().into_research_unmerged();
+        assert!(!ordinary.is_research_unmerged());assert!(research.is_research_unmerged());
+        assert_eq!(ordinary.n_rounds(),1);assert_eq!(research.n_rounds(),2);
+        assert_eq!(ordinary.specs(),research.specs());
+        assert_eq!(research.merged_specs(),ordinary.specs());
+        assert_eq!(ordinary.merged_specs(),vec![OracleSpec::new_zk(4)]);
+        assert_eq!(research.rounds().map(|r|r.len()).collect::<Vec<_>>(),vec![1,1]);
+    }
+    #[test]
+    fn default_round_closing_behavior_and_empty_schedule_stay_unchanged() {
+        let mut ordinary=OracleSchedule::new();
+        ordinary.push(OracleSpec::new(2));ordinary.push(OracleSpec::new(2));ordinary.end_round();
+        assert_eq!(ordinary.merged_specs(),vec![OracleSpec::new(3)]);
+        assert_eq!(ordinary.clone().into_research_unmerged().specs(),ordinary.specs());
+        let empty=OracleSchedule::new().into_research_unmerged();
+        assert!(empty.merged_specs().is_empty());assert_eq!(empty.n_rounds(),0);
+    }
+    #[test]
+    #[should_panic(expected="research groups must remain singleton")]
+    fn a_mutated_research_schedule_cannot_silently_admit_an_unclosed_group() {
+        let mut research=OracleSchedule::new().into_research_unmerged();
+        research.push(OracleSpec::new_zk(4));research.merged_specs();
+    }
