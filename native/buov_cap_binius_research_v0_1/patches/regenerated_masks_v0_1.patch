+
+/// Recompute the exact mask produced by `encode_masked` when its RNG starts
+/// as `StdRng::from_seed(*seed)`. Uses the SAME packed length, packed type and
+/// `par_rand<StdRng>` per-index sampler; seed bytes are private RAM-only coins.
+/// This helper neither changes oracle parameters nor observes a transcript.
+/// A seed must be fresh for each real committed oracle; fixed seeds are tests only.
+pub fn regenerate_mask_from_seed<P: PackedField, A: Allocator>(
+    log_len: usize, seed: &[u8;32], alloc: &A,
+) -> FieldBuffer<P,A::Vec<P>> {
+    assert!(log_len < usize::BITS as usize, "bounded regenerated-mask scalar dimension");
+    let packed_len = 1usize << log_len.saturating_sub(P::LOG_WIDTH);
+    let mut rng = StdRng::from_seed(*seed);
+    let mask_values = par_rand::<StdRng,_,_>(packed_len, &mut rng, P::random)
+        .collect_into_alloc_vec(alloc);
+    FieldBuffer::new(log_len,mask_values)
 }
 
