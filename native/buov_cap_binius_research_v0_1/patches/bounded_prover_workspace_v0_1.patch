@@ -0,0 +1,24 @@
+//! Same Gao-Mateer domain with an explicit bounded-memory research implementation.
+use binius_field::BinaryField;
+use binius_math::{BinarySubspace, ntt::{DomainContext, domain_context::{GaoMateerOnTheFly, GaoMateerPreExpanded}}};
+use either::Either;
+
+pub enum ProverDomain<F> {
+    Default(GaoMateerPreExpanded<F>),
+    Research(GaoMateerOnTheFly<F>),
+}
+impl<F: BinaryField> ProverDomain<F> {
+    pub fn generate(log_domain_size: usize, research: bool) -> Self {
+        if research { Self::Research(GaoMateerOnTheFly::generate(log_domain_size)) }
+        else { Self::Default(GaoMateerPreExpanded::generate(log_domain_size)) }
+    }
+}
+impl<F: BinaryField> DomainContext for ProverDomain<F> {
+    type Field=F;
+    fn log_domain_size(&self)->usize { match self {Self::Default(c)=>c.log_domain_size(),Self::Research(c)=>c.log_domain_size()} }
+    fn subspace(&self,i:usize)->BinarySubspace<F> {match self {Self::Default(c)=>c.subspace(i),Self::Research(c)=>c.subspace(i)}}
+    fn twiddle(&self,l:usize,b:usize)->F {match self {Self::Default(c)=>c.twiddle(l,b),Self::Research(c)=>c.twiddle(l,b)}}
+    fn iter_twiddles(&self,l:usize,s:usize)->impl Iterator<Item=F>+'_ {
+        match self {Self::Default(c)=>Either::Left(c.iter_twiddles(l,s)),Self::Research(c)=>Either::Right(c.iter_twiddles(l,s))}
+    }
+}
